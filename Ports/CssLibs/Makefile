# CssLibs port Makefile (LLVM Build, AArch64)
#
# Static archive of NetSurf's CSS stack for XenevaOS:
#   libparserutils (tokeniser/charset utils, WITHOUT_ICONV_FILTER build)
#   libwapcaplet   (string interning)
#   libcss         (CSS parse + cascade + select)
#
# The libcss property parsers (src/parse/properties/autogenerated_*.c) and
# select headers (src/select/autogenerated_*.h) are generator outputs that
# ship inside the upstream -src tarballs; they are vendored here as-is.
# Host tools used once to refresh them:
#   libcss .../css_property_parser_gen.c + properties.gen (host gcc)
#   libcss src/select/select_generator.py (host python3)
# See README.md for versions.

TOOLCHAIN ?= llvm

TARGET = libcssport.a
CROSS_COMPILE ?= aarch64-linux-gnu-

CSSLIB_ROOT = .

# All port sources, including the 119 vendored autogenerated_* parsers.
PU_SRCS = $(shell find $(CSSLIB_ROOT)/libparserutils/src $(CSSLIB_ROOT)/port -name '*.c')
WC_SRCS = $(shell find $(CSSLIB_ROOT)/libwapcaplet/src -name '*.c')
CSS_SRCS = $(shell find $(CSSLIB_ROOT)/libcss/src -name '*.c')

OBJDIR = obj
PU_OBJS = $(patsubst %.c,$(OBJDIR)/%.o,$(PU_SRCS))
WC_OBJS = $(patsubst %.c,$(OBJDIR)/%.o,$(WC_SRCS))
CSS_OBJS = $(patsubst %.c,$(OBJDIR)/%.o,$(CSS_SRCS))
OBJS = $(PU_OBJS) $(WC_OBJS) $(CSS_OBJS)

XE_INCLUDES = -I../../Libs/XEClib/includes -I../../Libs/XEClib/includes/c++
PU_INCLUDES = -I$(CSSLIB_ROOT)/libparserutils/include \
              -I$(CSSLIB_ROOT)/libparserutils/src
WC_INCLUDES = -I$(CSSLIB_ROOT)/libwapcaplet/include \
              -I$(CSSLIB_ROOT)/libwapcaplet/src
# NOTE: each group puts its OWN src dir first. libcss and libparserutils
# both ship a bare "utils/utils.h" (different files), so a single shared
# -I order cannot serve both trees.
CSS_INCLUDES = -I$(CSSLIB_ROOT)/libcss/include \
               -I$(CSSLIB_ROOT)/libcss/src \
               -I$(CSSLIB_ROOT)/libparserutils/include \
               -I$(CSSLIB_ROOT)/libwapcaplet/include

# WITHOUT_ICONV_FILTER: parserutils' iconv path needs a C library iconv;
# the internal codec path handles the UTF-8/ASCII CSS we feed it.
# __STDC_LIMIT_MACROS: XEClib gates INT32_MAX et al behind it (as do all
# app Makefiles).
# NOTE: libcss's INLINE enum constant (propstrings.h) is renamed to
# LIBCSS_INLINE in this port: XEClib's _xeneva.h defines INLINE as a macro
# and -U cannot help (the header redefines it on include). Upstream uses
# the same LIBCSS_ prefix convention for FLOAT/DOUBLE/STATIC clashes.
# -fcommon (in BASE_FLAGS): stylesheet.h ends `struct css_rule {...} _ALIGNED;`
# with _ALIGNED undefined -- a tentative definition per TU that historic
# GCC merged silently; clang needs -fcommon spelled out.
# -Dabort=ns_abort_trap: XEClib abort() exits silently; the trap in
# port/port.c prints the assert call site to serial before exiting.
COMMON_DEFS = -DWITHOUT_ICONV_FILTER -D__STDC_LIMIT_MACROS -D__TARGET_BOARD_QEMU_VIRT__ -Dabort=ns_abort_trap

BASE_FLAGS = -Wall -ffreestanding -fno-stack-protector -fno-stack-check -fno-strict-aliasing \
             -O2 -fcommon \
             $(COMMON_DEFS) \
             -Wno-unused-function -Wno-unused-variable -Wno-unused-but-set-variable \
             $(XE_INCLUDES)

ifeq ($(TOOLCHAIN), llvm)
    CC = clang
    AR = llvm-ar
    LLVM_TARGET = -target aarch64-unknown-windows
    PU_CFLAGS = $(BASE_FLAGS) $(LLVM_TARGET) $(PU_INCLUDES)
    WC_CFLAGS = $(BASE_FLAGS) $(LLVM_TARGET) $(WC_INCLUDES)
    CSS_CFLAGS = $(BASE_FLAGS) $(LLVM_TARGET) $(CSS_INCLUDES)
else
    CC = $(CROSS_COMPILE)gcc
    AR = $(CROSS_COMPILE)ar
    PU_CFLAGS = $(BASE_FLAGS) -fPIE $(PU_INCLUDES)
    WC_CFLAGS = $(BASE_FLAGS) -fPIE $(WC_INCLUDES)
    CSS_CFLAGS = $(BASE_FLAGS) -fPIE $(CSS_INCLUDES)
endif

.PHONY: all clean llvm

all: $(TARGET)

llvm:
	@$(MAKE) TOOLCHAIN=llvm all

$(PU_OBJS): $(OBJDIR)/%.o: %.c
	@mkdir -p $(dir $@)
	$(CC) $(PU_CFLAGS) -c $< -o $@

$(WC_OBJS): $(OBJDIR)/%.o: %.c
	@mkdir -p $(dir $@)
	$(CC) $(WC_CFLAGS) -c $< -o $@

$(CSS_OBJS): $(OBJDIR)/%.o: %.c
	@mkdir -p $(dir $@)
	$(CC) $(CSS_CFLAGS) -c $< -o $@

$(TARGET): $(OBJS)
	@echo "Archiving $(TARGET)..."
	$(AR) rcs $@ $(OBJS)

clean:
	rm -rf $(OBJDIR) $(TARGET)
